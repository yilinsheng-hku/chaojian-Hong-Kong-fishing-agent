# ============================================================================
# 默认模式（推荐）：内置测站数据问答引擎 (AGENT_MODEL=builtin)
# 无需任何云端 API Key，也无需在本地运行大模型，直接基于 9 个只读测站工具进行意图识别与组合回答。
# ============================================================================
AGENT_MODEL=builtin

# ============================================================================
# 可选扩展模式：如需接入本地 Ollama 或云端大模型，可按需配置（切勿将真实密钥提交至 Git）
# ============================================================================
# AGENT_MODEL=ollama:qwen2.5:7b
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
